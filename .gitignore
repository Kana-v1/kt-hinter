# Rules pipeline outputs (regenerated by tools/rules-pipeline/update-rules.sh).
# GW's PDFs must never be committed to a public repo.
/data/pdf/
/data/extracted/

# Swift / Xcode (project is generated by XcodeGen on CI)
.build/
.swiftpm/
/ios/*.xcodeproj/
/ios/KillTeam/Info.plist
DerivedData/
*.ipa

# Editor / OS
.DS_Store
*.swp
__pycache__/
/ios/build/
/ios/Payload/
/ios/build.log

# Personal, never published (e.g. the photo-crop tool)
/local/

# Problem reports from the phone: their screenshots can show the player's own
# operative photos. Only the folder's README is tracked.
/feedback/*
!/feedback/README.md
